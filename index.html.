
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WHOZIN - Films, Séries & Anime</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101010;color:white;font-family:Arial,sans-serif}
header{padding:18px 5%;display:flex;align-items:center;justify-content:space-between;background:#080808;position:sticky;top:0;z-index:5}
.logo{font-size:27px;font-weight:900;color:#e50914;letter-spacing:2px}
nav{display:flex;gap:15px;font-size:13px}
nav a{color:white;text-decoration:none}
.hero{padding:65px 6% 55px;background:linear-gradient(90deg,#090909 10%,#242020 65%,#111);min-height:300px}
.hero small{color:#e50914;font-weight:bold;letter-spacing:2px}
.hero h1{font-size:42px;margin:12px 0}
.hero p{max-width:430px;color:#ccc;line-height:1.6}
.btn{background:#e50914;color:white;border:0;padding:12px 20px;border-radius:5px;font-weight:bold;cursor:pointer}
.search{margin:22px 5%;width:90%;padding:14px;border:1px solid #444;border-radius:6px;background:#202020;color:white}
.categories{display:flex;gap:9px;overflow:auto;padding:0 5% 20px}
.categories button{background:#292929;color:white;border:1px solid #444;border-radius:20px;padding:9px 16px;white-space:nowrap}
.categories button.active{background:#e50914;border-color:#e50914}
h2{font-size:21px;margin:20px 5%}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:0 5% 30px}
.card{background:#202020;border-radius:8px;overflow:hidden;cursor:pointer}
.poster{height:175px;display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;font-size:23px;font-weight:900;background:linear-gradient(140deg,#541b25,#171717 70%)}
.card:nth-child(2n) .poster{background:linear-gradient(140deg,#173c50,#151515)}
.card:nth-child(3n) .poster{background:linear-gradient(140deg,#51401b,#151515)}
.info{padding:11px}
.info strong{font-size:14px}
.info p{font-size:12px;color:#aaa;margin:7px 0}
footer{text-align:center;padding:30px;color:#888;font-size:12px;background:#080808}
#details{display:none;position:fixed;inset:0;background:#000e;z-index:10;align-items:center;justify-content:center;padding:20px}
.dialog{background:#222;padding:25px;border-radius:10px;max-width:400px;width:100%}
.dialog button{margin-top:12px}
@media(min-width:700px){.grid{grid-template-columns:repeat(4,1fr)}.poster{height:230px}}
</style>
</head>
<body>
<header>
<div class="logo">WHOZIN</div>
<nav>
<a href="#home">Accueil</a>
<a href="#films">Films</a>
<a href="#anime">Anime</a>
</nav>
</header>

<section class="hero" id="home">
<small>BIENVENUE SUR WHOZIN</small>
<h1>Ton univers cinéma.</h1>
<p>Découvre des films, des séries et des animes dans un seul endroit.</p>
<button class="btn" onclick="document.getElementById('films').scrollIntoView()">Découvrir</button>
</section>

<input class="search" id="search" placeholder="🔍 Rechercher un film, une série, un anime..." oninput="filter()">

<div class="categories">
<button class="active" onclick="category('Tous',this)">Tous</button>
<button onclick="category('Film',this)">Films</button>
<button onclick="category('Série',this)">Séries</button>
<button onclick="category('Anime',this)">Anime</button>
<button onclick="category('Live',this)">Live</button>
</div>

<h2 id="films">À découvrir</h2>
<div class="grid" id="catalogue">
<div class="card" data-type="Film" onclick="openInfo('Film exemple','Film')">
<div class="poster">CINÉMA</div>
<div class="info"><strong>Film exemple</strong><p>Film • À découvrir</p></div>
</div>
<div class="card" data-type="Série" onclick="openInfo('Série exemple','Série')">
<div class="poster">SÉRIE</div>
<div class="info"><strong>Série exemple</strong><p>Série • À découvrir</p></div>
</div>
<div class="card" data-type="Anime" id="anime" onclick="openInfo('Anime exemple','Anime')">
<div class="poster">ANIME</div>
<div class="info"><strong>Anime exemple</strong><p>Anime • VF / VOSTFR</p></div>
</div>
<div class="card" data-type="Live" onclick="openInfo('Live exemple','Live')">
<div class="poster">LIVE</div>
<div class="info"><strong>Live exemple</strong><p>Direct • À découvrir</p></div>
</div>
</div>

<div id="details">
<div class="dialog">
<h2 id="detailTitle" style="margin:0 0 12px">Titre</h2>
<p id="detailText">Contenu de démonstration.</p>
<button class="btn" onclick="closeInfo()">Fermer</button>
</div>
</div>

<footer>© 2026 WHOZIN — Ton univers de divertissement.</footer>

<script>
let selected='Tous';
function filter(){
let q=document.getElementById('search').value.toLowerCase();
document.querySelectorAll('.card').forEach(c=>{
let match=c.innerText.toLowerCase().includes(q);
let type=selected==='Tous'||c.dataset.type===selected;
c.style.display=match&&type?'block':'none';
});
}
function category(type,button){
selected=type;
document.querySelectorAll('.categories button').forEach(b=>b.classList.remove('active'));
button.classList.add('active');
filter();
}
function openInfo(title,type){
document.getElementById('detailTitle').innerText=title;
document.getElementById('detailText').innerText=type+' — Ceci est une fiche de démonstration. Les vidéos seront ajoutées avec des contenus autorisés.';
document.getElementById('details').style.display='flex';
}
function closeInfo(){
document.getElementById('details').style.display='none';
}
</script>
</body>
</html>
